# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the app runs in local mode (no accounts, data only in this browser).
# Both are public by design: Row Level Security (supabase/migrations) protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
